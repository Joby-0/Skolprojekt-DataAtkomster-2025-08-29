{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationSecrets": {
        "SecretStorage": "UserSecrets"
    },
  
    "DatabaseConnections": {
      "DefaultDataUser": "root",    //"gstusr" | "usr" | "supusr" | "dbo" | "root"
      "MigrationUser": "root",    //migration is done by root user
      "UseDataSetWithTag": "sql-Sights-Johan_Bylander.sqlserver.docker" //"sql-creditcards.sqlserver.docker" | "sql-creditcards.mysql.docker" | "sql-creditcards.postgresql.docker"

      
    }
  
}




























